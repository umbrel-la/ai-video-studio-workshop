{
  "scenes": [
    [
      "reelforge",
      "ReelForge",
      "Акцент на смысле",
      "<div class=\"hero\"><span class=\"small\">ОДНА СЦЕНА</span><br><b id=\"word\">ОДНА ИДЕЯ</b><div id=\"line\" class=\"line\"></div></div>",
      "tl.fromTo('#word',{y:40,opacity:0},{y:0,opacity:1,duration:.5},.25).fromTo('#line',{scaleX:0},{scaleX:1,duration:.45,transformOrigin:'left'},.8);"
    ],
    [
      "tegaki",
      "Tegaki",
      "Рукописный акцент",
      "<div id=\"ink\" class=\"ink\"></div><p class=\"caption\">Короткая подпись, управляемая временем</p>",
      "const ink=new StudioTegaki.TegakiEngine(document.querySelector('#ink'),{text:'Idea',font:StudioTegaki.caveat,fontSize:112,color:'#b8eadc',time:{mode:'controlled',value:0}}); document.querySelectorAll('#ink [data-tegaki=sentinel], #ink [data-tegaki=overlay], #ink [data-tegaki=canvas-fallback]').forEach(el=>el.setAttribute('data-layout-ignore','')); const proxy={t:0};tl.fromTo(proxy,{t:0},{t:4,duration:2.4,ease:'none',onUpdate:()=>ink.update({time:{mode:'controlled',value:proxy.t}})},.15);"
    ],
    [
      "animated-diagrams",
      "Animated Diagrams",
      "Понятная последовательность",
      "<svg class=\"graph\" viewBox=\"0 0 420 300\"><path id=\"edge\" d=\"M80 95 H340 V225 H210\" fill=\"none\" stroke=\"#b8eadc\" stroke-width=\"5\"/><g id=\"nodes\"><rect x=\"10\" y=\"50\" width=\"140\" height=\"90\" rx=\"12\"/><rect x=\"270\" y=\"50\" width=\"140\" height=\"90\" rx=\"12\"/><rect x=\"140\" y=\"180\" width=\"140\" height=\"90\" rx=\"12\"/></g><g fill=\"#15273c\" font-size=\"22\" text-anchor=\"middle\"><text x=\"80\" y=\"105\">Задача</text><text x=\"340\" y=\"105\">Действие</text><text x=\"210\" y=\"235\">Проверка</text></g></svg>",
      "tl.fromTo('#nodes rect',{opacity:0,scale:.9,transformOrigin:'center'},{opacity:1,scale:1,stagger:.22,duration:.3},.2).fromTo('#edge',{strokeDasharray:520,strokeDashoffset:520},{strokeDashoffset:0,duration:1.3,ease:'none'},.5);"
    ],
    [
      "design-engineering",
      "Design Engineering",
      "Звук следует движению",
      "<div class=\"sound\"><div id=\"pulse\" class=\"pulse\"></div><span>КОНТАКТ → ЗВУК</span></div><p class=\"caption\">Локальный синтез. Без загрузки записи.</p>",
      "tl.fromTo('#pulse',{scale:.1,opacity:0},{scale:1,opacity:1,duration:.5},.3).to('#pulse',{scale:1.12,duration:.12},.8).to('#pulse',{scale:1,duration:.2},.92);"
    ],
    [
      "huashu-design",
      "Huashu Design",
      "Камера направляет внимание",
      "<div class=\"viewport\"><div id=\"camera\"><p class=\"tiny\">ИЛЛЮСТРАЦИЯ</p><h2>Важная строка</h2><p>Сохраняем начало и конец текста.</p><div class=\"focus-line\"></div></div></div>",
      "tl.fromTo('#camera',{scale:1,x:0},{scale:1.12,x:-8,duration:2.4,ease:'none'},.2);"
    ],
    [
      "herk-edit-kit",
      "Herk Edit Kit",
      "Карточка добавляет смысл",
      "<div class=\"card\" id=\"card\"><span class=\"small\">ПРИЁМ</span><h2>Покажи результат</h2><p>Затем объясни, как его проверить.</p></div>",
      "tl.fromTo('#card',{y:65,rotation:-3,opacity:0},{y:0,rotation:0,opacity:1,duration:.65,ease:'power3.out'},.2);"
