      "tl.fromTo('.final',{y:30,opacity:0},{y:0,opacity:1,duration:.7},.2);"
    ]
  ],
  "css": "@font-face{font-family:StudioSans;src:url('assets/NotoSans.ttf')}@font-face{font-family:Inter;src:url('assets/NotoSans.ttf')}*{box-sizing:border-box}#root{position:absolute;inset:0;width:540px;height:960px;background:#112139;color:#f5f3ed;font-family:StudioSans,Arial,sans-serif;overflow:hidden}.eyebrow{position:absolute;left:42px;top:98px;font-size:16px;color:#b8eadc;letter-spacing:2px}.heading{position:absolute;left:42px;top:154px;width:456px;font-size:34px;line-height:1.2;margin:0}.source{position:absolute;left:42px;top:800px;width:456px;font-size:18px;color:#a9bdd1}.tag{position:absolute;left:42px;top:860px;font-size:15px;color:#a9bdd1}.stage{position:absolute;left:42px;top:310px;width:456px;height:420px}.hero{padding-top:60px;font-size:42px}.small{font-size:16px;color:#4b6b70;letter-spacing:1px}.hero .small{color:#9fb5ca}.line{height:10px;background:#b8eadc;width:365px;margin-top:18px}.ink{position:absolute;left:24px;top:52px;width:408px;height:170px;font-size:112px;color:#b8eadc}.caption{position:absolute;left:12px;top:310px;width:432px;font-size:19px;line-height:1.4;color:#a9bdd1;text-align:center}.graph{width:100%;height:330px}.graph rect{fill:#e9eee5}.sound{padding-top:30px;text-align:center;font-size:23px}.pulse{width:150px;height:150px;background:#b8eadc;border-radius:50%;margin:0 auto 28px}.viewport{margin-top:35px;height:240px;overflow:hidden;background:#edf1e8;border-radius:16px;color:#15273c;padding:26px}#camera{transform-origin:20% 50%}.tiny{font-size:15px;color:#4b6b70}h2{font-size:29px;line-height:1.2;margin:18px 0}p{font-size:21px;line-height:1.4}.focus-line{height:7px;width:220px;background:#559e91}.card{background:#eeeade;color:#15273c;border-radius:20px;padding:34px;margin-top:30px;height:280px;box-shadow:8px 8px 0 #487c7c}.bars{display:flex;gap:50px;justify-content:center;align-items:flex-end;height:280px}.bars>div{height:270px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:10px;font-size:28px}.bars i{display:block;width:100px;background:#b8eadc;border-radius:6px 6px 0 0}#bar-a{height:95px}#bar-b{height:220px}.tiles{padding-top:5px}.tiles>div{padding:22px;background:#e8eee4;color:#15273c;margin:12px;font-size:25px;border-radius:12px}#tile-b{background:#b8eadc}#tile-c{background:#d7c4a4}.morph{position:absolute;left:48px;top:75px;width:360px;height:220px;background:#b8eadc;color:#15273c;display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:700}.cursor{position:absolute;left:240px;top:170px;font-size:70px;color:#f8f6f0;text-shadow:2px 2px #15273c}.final{text-align:center;padding-top:5px}.final strong{font-size:142px;color:#b8eadc}.final p{font-size:25px}.final span{font-size:17px;color:#a9bdd1}"
}
